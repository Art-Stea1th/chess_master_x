<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>ChessMaster</RootNamespace>
    <AssemblyName>ChessMaster.Setup</AssemblyName>
    <ApplicationIcon>..\ChessMaster\Assets\knight.ico</ApplicationIcon>
    <Product>Chess Master</Product>
    <Description>Installer shell for Chess Master</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ChessMaster\AppTheme.cs" Link="AppTheme.cs" />
    <Compile Include="..\ChessMaster\ThemedForm.cs" Link="ThemedForm.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\ChessMaster\Assets\knight.png" LogicalName="ChessMaster.Assets.knight.png" />
    <EmbeddedResource Include="..\ChessMaster\Assets\knight.ico" LogicalName="ChessMaster.Assets.knight.ico" />
    <EmbeddedResource Include="..\..\installer\engine\ChessMaster-Engine-1.0.0.exe" LogicalName="ChessMaster.Setup.Engine.exe" />
  </ItemGroup>

</Project>
